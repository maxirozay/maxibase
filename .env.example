# server
NUXT_SESSION_PASSWORD={randomString(32)}
NUXT_SESSION_MAX_AGE=3600 # 1 hour
NUXT_SESSION_UNIQUE=false # if true, a new login revokes the other sessions, which end within NUXT_SESSION_MAX_AGE
NUXT_REFRESH_TOKEN_MAX_AGE=2592000 # 1 month
NUXT_DB=postgres://{dbUser}:{dbPassword}@postgres:5432/{dbName}
NUXT_AUTO_SIGNUP=false
NUXT_FORCE_MFA=false
NUXT_FILES_PUBLIC_FOLDER=files/public # don't use public else it will overwrite nuxt folder
NUXT_FILES_PRIVATE_FOLDER=files/private
NUXT_LOGS_RETENTION_DAYS=90 # 90 days
NUXT_BACKUP_RETENTION_DAYS=30 # 30 days
NUXT_BACKUP_DUMP_ARGS="-F c"
NUXT_BACKUP_AGE_PUBLIC_KEY= # age public key to encrypt backups, empty means no encryption
NUXT_RATE_LIMIT_ENABLED=true
NUXT_RATE_LIMIT_BAN_MULTIPLIER=5 # ban after limit x multiplier requests in one window
NUXT_RATE_LIMIT_BAN_SECONDS=3600 # 1 hour
NUXT_RATE_LIMIT_TRUSTED_PROXIES=1 # reverse proxies in front of the app, 0 if directly exposed

# public
NUXT_PUBLIC_NAME="Nuxt Base"
NUXT_PUBLIC_URL=https://web.site
NUXT_PUBLIC_LOGO=https://placehold.co/200x100?text=logo
NUXT_PUBLIC_ANONYMOUS_SIGNUP=false
NUXT_PUBLIC_PASSWORD_MIN=16
NUXT_PUBLIC_PASSWORD_MAX=64
NUXT_PUBLIC_REFRESH_TOKEN_ROTATE_AFTER=86400 # get a new token after 1 day
NUXT_PUBLIC_RECENT_AUTH_MAX_AGE=300 # in seconds, time before a checkAuth needed before a sensitive action
NUXT_PUBLIC_FILES_URL=/files
NUXT_PUBLIC_FILES_CHUNK_SIZE=5 # in MB (min for S3 is 5MB, usually nginx has a default max body size of 1MB)

# Oauth
NUXT_OAUTH_MICROSOFT_CLIENT_ID={clientId}
NUXT_OAUTH_MICROSOFT_CLIENT_SECRET={secret}
NUXT_OAUTH_MICROSOFT_TENANT={tenant}
NUXT_PUBLIC_OAUTH_MICROSOFT=true # display the sign in button

# S3 (optional - Leave empty for local storage)
NUXT_S3_ENDPOINT=https://s3.pub2.infomaniak.cloud
NUXT_S3_PUBLIC_BUCKET=public
NUXT_S3_PRIVATE_BUCKET=private
NUXT_S3_ACCESS_KEY_ID={accessKey}
NUXT_S3_SECRET_ACCESS_KEY={secretAccessKey}
NUXT_S3_REDIRECT=true # 302 to a presigned S3 URL instead of streaming files through the app: no proxied egress, S3 handles ranges and resume, but the signed URL is exposed to the client (valid 1h, or the ?expireIn= query param) and the bucket needs CORS for files fetched from JS rather than <img>/<video>

# SMTP
NUXT_SMTP_HOST=mail.infomaniak.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=noreply@web.site
NUXT_SMTP_FROM=noreply@web.site
NUXT_SMTP_PASS={smtpPassword}

# deployment
SERVER_URL={user}@{host}
SERVER_PORT=3000
PROJECT_NAME={name}
REMOTE_PATH="~/{path}"
SSH_KEY_NAME={sshKeyName}

# server db `pnpm db:push-prod` — opens an SSH tunnel to $SERVER_URL and reuses the
# NUXT_DB from $REMOTE_PATH/.env there, so no database password is stored locally
