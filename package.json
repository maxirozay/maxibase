{
  "name": "maxibase",
  "version": "1.0.1",
  "description": "Nuxt layer with auth, files, logs and backups",
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "auth",
    "webauthn",
    "drizzle"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "docker",
    "layers/base",
    "locales",
    "scripts",
    "server/assets",
    "nuxt.config.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxirozay/nuxt-base.git"
  },
  "homepage": "https://github.com/maxirozay/nuxt-base#readme",
  "bugs": {
    "url": "https://github.com/maxirozay/nuxt-base/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prod": "./scripts/deploy.sh",
    "rollback": "./scripts/rollback.sh",
    "db:seed": "npx jiti ./server/database/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push-prod": "./scripts/db/push-server.sh",
    "db:restore": "./scripts/db/restore.sh",
    "db:migrate": "npx jiti ./scripts/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@iconify-json/lucide": "^1.2.140",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/icon": "^2.5.1",
    "@pinia/nuxt": "^1.0.2",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-orm": "1.0.0-rc.3",
    "goku-css": "^9.0.8",
    "nodemailer": "^9.1.1",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-i18n-micro": "^3.30.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-seed": "1.0.0-rc.3",
    "maxibase": "link:.",
    "nuxt": "^4.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
